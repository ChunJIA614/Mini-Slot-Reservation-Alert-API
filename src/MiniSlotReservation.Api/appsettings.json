{
  "ConnectionStrings": {
    "Reservations": "Data Source=reservations.db;Default Timeout=5"
  },
  "ReservationSchedule": {
    "TimeZoneId": "Asia/Kuala_Lumpur",
    "FallbackTimeZoneId": "Singapore Standard Time",
    "OpensAtLocal": "09:00:00",
    "ClosesAtLocal": "17:00:00"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
